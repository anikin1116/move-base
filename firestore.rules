rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // companies: public read (only active), partner writes own doc
    match /companies/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    // child locations (e.g. uid_s2, uid_s3)
    match /companies/{docId} {
      allow write: if request.auth != null && docId.matches(request.auth.uid + '_s[0-9]+');
    }

    // click tracking: authenticated users can increment
    match /partner_clicks/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
